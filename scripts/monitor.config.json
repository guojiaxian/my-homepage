{
  "$comment": "监控网关配置。hosts 为纳管主机（type: local 本机 / ssh 远程）；hosts[].appRoot 为该机应用探测根目录（管理员设置，每台可不同）：probe-apps.mjs 扫描该目录自动发现应用（每个子目录 = 一个应用；目录本身含 .git/package.json 等标记时视为单一应用），应用中心与监控中心共用这一份探测结果；trackedDirs 为手工追加的跟踪目录（探测发现的应用目录自动并入，来源标记 probe）；thresholds 为告警阈值（sustainMin 持续分钟才触发）。改此文件 ≤2s 热加载；也可在 /monitor/ 界面配置。",
  "port": 8301,
  "auth": {
    "sessionTtlHours": 8760,
    "maxFailPerMin": 5
  },
  "collect": {
    "localIntervalSec": 5,
    "remoteIntervalSec": 20,
    "retentionDays": 7,
    "dockerRefreshSec": 30
  },
  "thresholds": {
    "cpuPct": 85,
    "memPct": 90,
    "diskPct": 90,
    "loadPerCore": 2,
    "sustainMin": 3
  },
  "terminal": {
    "idleTimeoutMin": 480,
    "maxSessionMin": 720,
    "maxSessionsPerHost": 10,
    "recordCommands": true,
    "pingIntervalSec": 300
  },
  "webhookUrl": "",
  "hosts": [
    {
      "id": "local",
      "name": "本机 · 应用中心",
      "type": "local",
      "group": "内网",
      "mode": "ssh",
      "address": "10.8.11.4",
      "appRoot": "/root/applications",
      "terminal": {
        "host": "127.0.0.1",
        "port": 22,
        "username": "root",
        "authType": "key",
        "keyPath": "/root/.ssh/id_rsa"
      },
      "trackedDirs": []
    },
    {
      "id": "netwatch",
      "name": "NetWatch 网络监控",
      "type": "ssh",
      "group": "内网",
      "mode": "agent",
      "address": "10.8.14.200",
      "port": 22,
      "username": "root",
      "authType": "key",
      "keyPath": "/root/applications/my-homepage/data/monitor/keys/netwatch",
      "appRoot": "/root/network-monitor",
      "trackedDirs": [
        {
          "path": "/root/network-monitor",
          "name": "network-monitor",
          "source": "host"
        }
      ]
    },
    {
      "id": "lan-1103",
      "name": "网络自动运维系统",
      "type": "ssh",
      "group": "内网",
      "mode": "agent",
      "address": "10.8.11.3",
      "port": 22,
      "username": "root",
      "authType": "key",
      "keyPath": "/root/applications/my-homepage/data/monitor/keys/lan-1103",
      "appRoot": "/root/log_gpt_agent",
      "trackedDirs": [
        {
          "path": "/root/log_gpt_agent",
          "name": "log_gpt_agent",
          "source": "host"
        }
      ]
    },
    {
      "id": "aliyun",
      "name": "StudyLog-云端",
      "type": "ssh",
      "group": "公网",
      "mode": "ssh",
      "address": "47.95.140.199",
      "port": 22,
      "username": "root",
      "authType": "key",
      "keyPath": "/root/applications/my-homepage/data/monitor/keys/aliyun",
      "appRoot": "/root/applications",
      "trackedDirs": [
        {
          "path": "/root/applications/studylog",
          "name": "studylog",
          "source": "host"
        },
        {
          "path": "/root/applications/shunfeng-ledger-wxmp/server",
          "name": "shunfeng-ledger-wxmp/server",
          "source": "host"
        },
        {
          "path": "/root/applications/shunfeng-ledger/server",
          "name": "shunfeng-ledger/server",
          "source": "host"
        }
      ]
    }
  ],
  "trackedDirs": []
}
